# Анализируемый проект: абсолютный путь на хосте, монтируется в контейнер как /project
PROJECT_DIR=/home/user/projects/backend

# Каталог результатов на хосте, монтируется как /out
OUT_DIR=./out

# Образ и его тег: latest — последняя сборка, vX.Y.Z — конкретный выпуск
IMAGE=ghcr.io/united-software-platform/project-snapshot
IMAGE_TAG=latest

# Версия tldr, скачиваемая при локальной сборке образа
TLDR_VERSION=0.4.0

# Владелец файлов результата: подставьте вывод id -u и id -g
HOST_UID=1000
HOST_GID=1000

# Ключ Claude API нужен только для извлечения требований из документов
ANTHROPIC_API_KEY=
