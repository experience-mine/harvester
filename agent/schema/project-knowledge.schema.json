{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-knowledge.schema.json",
  "title": "Project Knowledge File",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "filters",
    "project",
    "repositories",
    "branches",
    "tags",
    "commits",
    "people",
    "directories",
    "files",
    "technologies",
    "dependencies",
    "migrations",
    "database_objects",
    "documents",
    "requirements",
    "relationships",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "filters": {"$ref": "#/$defs/filters"},
    "project": {"$ref": "#/$defs/project"},
    "repositories": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "branches": {"type": "array", "items": {"$ref": "#/$defs/branch"}},
    "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}},
    "commits": {"type": "array", "items": {"$ref": "#/$defs/commit"}},
    "people": {"type": "array", "items": {"$ref": "#/$defs/person"}},
    "directories": {"type": "array", "items": {"$ref": "#/$defs/directory"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "technologies": {"type": "array", "items": {"$ref": "#/$defs/technology"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}},
    "database_objects": {"type": "array", "items": {"$ref": "#/$defs/database_object"}},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "identifier": {"type": "string", "pattern": "^[a-z_]+:.+$"},
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "exclude"],
      "properties": {
        "authors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^evidence:.+$"}
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug", "root_path", "agent_version", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^project:.+$"},
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "root_path": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "agent_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "default_branch", "head_commit_id", "is_dirty", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^repository:.+$"},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "remote_url": {"type": "string"},
        "default_branch": {"type": "string"},
        "head_commit_id": {"type": ["string", "null"], "pattern": "^commit:[0-9a-f]{40}$"},
        "is_dirty": {"type": "boolean"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository_id", "name", "commit_id", "is_default", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^branch:.+$"},
        "repository_id": {"type": "string", "pattern": "^repository:.+$"},
        "name": {"type": "string", "minLength": 1},
        "commit_id": {"type": "string", "pattern": "^commit:[0-9a-f]{40}$"},
        "is_default": {"type": "boolean"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository_id", "name", "commit_id", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^tag:.+$"},
        "repository_id": {"type": "string", "pattern": "^repository:.+$"},
        "name": {"type": "string", "minLength": 1},
        "commit_id": {"type": "string", "pattern": "^commit:[0-9a-f]{40}$"},
        "message": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "repository_id", "sha", "short_sha", "subject", "message",
        "authored_at", "committed_at", "author_id", "committer_id",
        "parent_ids", "is_merge", "changes", "evidence_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^commit:[0-9a-f]{40}$"},
        "repository_id": {"type": "string", "pattern": "^repository:.+$"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "short_sha": {"type": "string", "pattern": "^[0-9a-f]{7}$"},
        "subject": {"type": "string"},
        "message": {"type": "string"},
        "authored_at": {"$ref": "#/$defs/timestamp"},
        "committed_at": {"$ref": "#/$defs/timestamp"},
        "author_id": {"type": "string", "pattern": "^person:.+$"},
        "committer_id": {"type": "string", "pattern": "^person:.+$"},
        "parent_ids": {"type": "array", "items": {"type": "string", "pattern": "^commit:[0-9a-f]{40}$"}},
        "is_merge": {"type": "boolean"},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change_type", "insertions", "deletions"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "change_type": {"enum": ["added", "modified", "deleted", "renamed", "copied"]},
        "insertions": {"type": "integer", "minimum": 0},
        "deletions": {"type": "integer", "minimum": 0},
        "previous_path": {"type": "string", "minLength": 1}
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "email", "aliases", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^person:.+$"},
        "name": {"type": "string"},
        "email": {"type": "string"},
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "email"],
            "properties": {"name": {"type": "string"}, "email": {"type": "string"}}
          }
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository_id", "path", "name", "parent_id", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^directory:.+$"},
        "repository_id": {"type": ["string", "null"], "pattern": "^repository:.+$"},
        "path": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "parent_id": {"$ref": "#/$defs/identifier"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "repository_id", "path", "name", "extension",
        "directory_id", "size_bytes", "sha256", "is_binary", "role", "evidence_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^file:.+$"},
        "repository_id": {"type": ["string", "null"], "pattern": "^repository:.+$"},
        "path": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "extension": {"type": "string", "pattern": "^[^/]*$"},
        "directory_id": {"type": "string", "pattern": "^directory:.+$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "is_binary": {"type": "boolean"},
        "role": {"enum": ["source", "manifest", "migration", "documentation", "configuration", "test", "asset", "other"]},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug", "category", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^technology:.+$"},
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "category": {"enum": ["language", "framework", "library", "database", "runtime", "tool", "platform"]},
        "version": {"type": "string"},
        "confidence": {"enum": ["declared", "inferred"]},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "name", "version_constraint", "scope", "manifest_file_id", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^dependency:.+$"},
        "ecosystem": {"enum": ["pypi", "npm", "packagist", "go", "crates"]},
        "name": {"type": "string", "minLength": 1},
        "version_constraint": {"type": "string", "minLength": 1},
        "resolved_version": {"type": "string"},
        "scope": {"enum": ["runtime", "development", "optional"]},
        "manifest_file_id": {"type": "string", "pattern": "^file:.+$"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository_id", "file_id", "identifier", "format", "operations", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^migration:.+$"},
        "repository_id": {"type": "string", "pattern": "^repository:.+$"},
        "file_id": {"type": "string", "pattern": "^file:.+$"},
        "identifier": {"type": "string", "minLength": 1},
        "format": {"enum": ["sql", "alembic"]},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "object_kind", "object_name", "details"],
      "properties": {
        "operation": {
          "enum": [
            "create_table", "alter_table", "drop_table",
            "add_column", "alter_column", "drop_column",
            "create_index", "drop_index", "add_constraint", "drop_constraint"
          ]
        },
        "object_kind": {"enum": ["table", "column", "index", "constraint"]},
        "object_name": {"type": "string", "minLength": 1},
        "details": {"type": "string"}
      }
    },
    "database_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "parent_id", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^database_object:.+$"},
        "kind": {"enum": ["table", "column", "index", "constraint"]},
        "name": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"], "pattern": "^database_object:.+$"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository_id", "file_id", "title", "format", "language", "char_count", "headings", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^document:.+$"},
        "repository_id": {"type": "string", "pattern": "^repository:.+$"},
        "file_id": {"type": "string", "pattern": "^file:.+$"},
        "title": {"type": "string", "minLength": 1},
        "format": {"enum": ["markdown", "restructuredtext"]},
        "language": {"type": "string", "pattern": "^[a-z]{2}$"},
        "char_count": {"type": "integer", "minimum": 0},
        "headings": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document_id", "type", "title", "statement", "source_heading", "source_char_range", "extraction", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^requirement:[0-9a-f]{16}$"},
        "document_id": {"type": "string", "pattern": "^document:.+$"},
        "type": {"enum": ["business", "functional", "non_functional", "use_case", "user_story", "acceptance_criterion"]},
        "external_code": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source_heading": {"type": "string"},
        "source_char_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 0}
        },
        "extraction": {"$ref": "#/$defs/extraction"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence"],
      "properties": {
        "method": {"enum": ["llm", "marker"]},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "from_id", "to_id", "attributes", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^relationship:[0-9a-f]{16}$"},
        "type": {
          "enum": [
            "HAS_REPOSITORY", "HAS_COMMIT", "HAS_BRANCH", "HAS_TAG", "POINTS_TO", "PARENT_OF",
            "AUTHORED_BY", "COMMITTED_BY", "MODIFIES", "CONTAINS", "DECLARES",
            "DEFINES", "AFFECTS", "BELONGS_TO", "STATES", "REFINES", "VERIFIES",
            "USES", "INDICATES"
          ]
        },
        "from_id": {"$ref": "#/$defs/identifier"},
        "to_id": {"$ref": "#/$defs/identifier"},
        "attributes": {"type": "object"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_id", "subject_type", "source_kind", "analyzer", "analyzer_version", "collected_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^evidence:[0-9a-f]{16}$"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "subject_type": {
          "enum": [
            "project", "repository", "branch", "tag", "commit", "person",
            "directory", "file", "technology", "dependency", "migration",
            "database_object", "document", "requirement", "relationship"
          ]
        },
        "source_kind": {"enum": ["git", "filesystem", "manifest", "migration", "document", "llm"]},
        "source_file_id": {"type": ["string", "null"], "pattern": "^file:.+$"},
        "source_commit_id": {"type": ["string", "null"], "pattern": "^commit:[0-9a-f]{40}$"},
        "source_locator": {"type": ["string", "null"]},
        "analyzer": {"type": "string", "minLength": 1},
        "analyzer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "collected_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
